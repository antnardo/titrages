% --- l'outil commun : les fractions en expression pgfmath -------------------------
%
% Les fractions ont la même forme en pH et en potentiel :
%   x_j = 1 / sum_m 10^( (A_m - A_j) MA + (B_m - B_j) MB + (c_m - c_j) MC ),
% avec A, B, c des nombres (calculés ici) et MA, MB, MC des expressions (le pH x,
% ou E/s et pH pour le rédox). Aucun quotient de nombres démesurés.

\cs_new_protected:Npn \__titrages_pgf_fractions:nnn #1 #2 #3
  {
    \seq_clear:N \l__titrages_x_seq
    \int_set:Nn \l__titrages_N_int { \seq_count:N \l__titrages_A_seq }
    \int_step_inline:nn { \l__titrages_N_int }
      {
        \tl_set:Nn \l__titrages_pgf_tl { 1 / ( 0 }
        \int_step_inline:nn { \l__titrages_N_int }
          {
            \tl_put_right:Nx \l__titrages_pgf_tl
              {
                + 10^( ( \fp_eval:n { \seq_item:Nn \l__titrages_A_seq { ####1 }
                                      - \seq_item:Nn \l__titrages_A_seq { ##1 } } ) * ( \exp_not:n { #1 } )
                       + ( \fp_eval:n { \seq_item:Nn \l__titrages_B_seq { ####1 }
                                        - \seq_item:Nn \l__titrages_B_seq { ##1 } } ) * ( \exp_not:n { #2 } )
                       + ( \fp_eval:n { \seq_item:Nn \l__titrages_c_seq { ####1 }
                                        - \seq_item:Nn \l__titrages_c_seq { ##1 } } ) * ( \exp_not:n { #3 } ) )
              }
          }
        \tl_put_right:Nn \l__titrages_pgf_tl { ) }
        \seq_put_right:NV \l__titrages_x_seq \l__titrages_pgf_tl
      }
  }

% Les pKa, évalués et triés : l'ordre donné n'engage pas.
\cs_new_protected:Npn \__titrages_pKa_trier:
  {
    \clist_set:Nx \l__titrages_pKa_clist
      { \clist_map_function:NN \l__titrages_pKa_clist \__titrages_fp_virgule:n }
    \clist_sort:Nn \l__titrages_pKa_clist
      { \fp_compare:nNnTF { ##1 } > { ##2 } { \sort_return_swapped: } { \sort_return_same: } }
  }
\cs_new:Npn \__titrages_fp_virgule:n #1 { \fp_eval:n { #1 } , }

% A_j = -(pKa_1 + … + pKa_j), c_j = j.
\cs_new_protected:Npn \__titrages_pgf_acidobasique:
  {
    \seq_clear:N \l__titrages_A_seq
    \seq_clear:N \l__titrages_B_seq
    \seq_clear:N \l__titrages_c_seq
    \fp_zero:N \l__titrages_s_fp
    \seq_put_right:Nn \l__titrages_A_seq { 0 }
    \clist_map_inline:Nn \l__titrages_pKa_clist
      {
        \fp_sub:Nn \l__titrages_s_fp { ##1 }
        \seq_put_right:Nx \l__titrages_A_seq { \fp_use:N \l__titrages_s_fp }
      }
    \int_step_inline:nnn { 0 } { \clist_count:N \l__titrages_pKa_clist }
      {
        \seq_put_right:Nn \l__titrages_B_seq { 0 }
        \seq_put_right:Nn \l__titrages_c_seq { ##1 }
      }
    \__titrages_pgf_fractions:nnn { 1 } { 0 } { x }
  }

% --- clés : une espèce acido-basique ------------------------------------------------

\keys_define:nn { titrages / espece }
  {
    pKa     .code:n = { \clist_set:Nx \l__titrages_pKa_clist { #1 } } ,
    C       .code:n = { \fp_set:Nn \l__titrages_C_fp { #1 } } ,
    forme   .code:n = { \int_set:Nn \l__titrages_q_int { #1 } } ,
    lambda  .code:n = { \clist_set:Nx \l__titrages_lambda_clist { #1 } } ,
    charge  .code:n = { \int_set:Nn \l__titrages_z_int { #1 } } ,
    contre~ion .code:n =
      { \fp_set:Nn \l__titrages_lamci_fp { #1 } \bool_set_true:N \l__titrages_lamci_bool } ,
  }

\cs_new_protected:Npn \__titrages_espece:n #1
  {
    \clist_clear:N \l__titrages_pKa_clist
    \clist_clear:N \l__titrages_lambda_clist
    \fp_zero:N \l__titrages_C_fp
    \int_zero:N \l__titrages_q_int
    \int_zero:N \l__titrages_z_int
    \bool_set_false:N \l__titrages_lamci_bool
    \keys_set:nn { titrages / espece } { #1 }
    \__titrages_pKa_trier:
    \tl_put_right:Nx \l__titrages_lua_tl
      {
        { pKa = { \l__titrages_pKa_clist } ,
          C = \fp_use:N \l__titrages_C_fp ,
          q = \int_use:N \l__titrages_q_int ,
          z0 = \int_use:N \l__titrages_z_int ,
          lam = { \clist_map_function:NN \l__titrages_lambda_clist \__titrages_fp_virgule:n } ,
          lamci = \bool_if:NTF \l__titrages_lamci_bool { \fp_use:N \l__titrages_lamci_fp } { nil } } ,
      }
    \__titrages_pgf_acidobasique:
    % la charge : C (sum_j j x_j - q)
    \tl_put_right:Nx \l__titrages_charge_tl
      { + ( \fp_use:N \l__titrages_C_fp ) * ( 0 - \int_use:N \l__titrages_q_int }
    \int_step_inline:nn { \seq_count:N \l__titrages_x_seq }
      {
        \tl_put_right:Nx \l__titrages_charge_tl
          { + \int_eval:n { ##1 - 1 } * ( \seq_item:Nn \l__titrages_x_seq { ##1 } ) }
      }
    \tl_put_right:Nn \l__titrages_charge_tl { ) }
    % la conductivité : C sum_j lambda_j x_j sur les formes chargées, et le contre-ion
    \int_step_inline:nn { \seq_count:N \l__titrages_x_seq }
      {
        \int_compare:nNnF { \l__titrages_z_int - ##1 + 1 } = { 0 }
          {
            \int_compare:nNnTF { \clist_count:N \l__titrages_lambda_clist } < { ##1 }
              { \bool_set_false:N \l__titrages_sigma_bool }
              {
                \tl_put_right:Nx \l__titrages_sigma_tl
                  {
                    + ( \fp_eval:n { \clist_item:Nn \l__titrages_lambda_clist { ##1 }
                                     * \l__titrages_C_fp } )
                      * ( \seq_item:Nn \l__titrages_x_seq { ##1 } )
                  }
              }
          }
      }
    \int_compare:nNnF { \l__titrages_z_int } = { \l__titrages_q_int }
      {
        \bool_if:NTF \l__titrages_lamci_bool
          {
            \tl_put_right:Nx \l__titrages_sigma_tl
              {
                + \fp_eval:n { \l__titrages_lamci_fp * \l__titrages_C_fp
                               * abs ( \l__titrages_z_int - \l__titrages_q_int ) }
              }
          }
          { \bool_set_false:N \l__titrages_sigma_bool }
      }
  }
\tl_new:N \l__titrages_charge_tl

% --- clés : une solution acido-basique ----------------------------------------------

\keys_define:nn { titrages / solution }
  {
    espece     .code:n = { \__titrages_espece:n { #1 } } ,
    acide~fort .code:n = { \fp_add:Nn \l__titrages_acide_fp { #1 } } ,
    base~forte .code:n = { \fp_add:Nn \l__titrages_base_fp { #1 } } ,
    lambda~acide~fort .code:n = { \fp_set:Nn \l__titrages_lamA_fp { #1 } } ,
    lambda~base~forte .code:n = { \fp_set:Nn \l__titrages_lamB_fp { #1 } } ,
  }

\cs_new_protected:Npn \__titrages_solution:nn #1 #2
  {
    \tl_clear:N \l__titrages_lua_tl
    \tl_set:Nn \l__titrages_charge_tl { 0 }
    \tl_set:Nn \l__titrages_sigma_tl { 0 }
    \bool_set_true:N \l__titrages_sigma_bool
    \fp_zero:N \l__titrages_acide_fp
    \fp_zero:N \l__titrages_base_fp
    \fp_set:Nn \l__titrages_lamA_fp { 7.63 }  % Cl-
    \fp_set:Nn \l__titrages_lamB_fp { 5.01 }  % Na+
    \keys_set:nn { titrages / solution } { #2 }
    \tl_set_eq:cN { l__titrages_ #1 _lua_tl } \l__titrages_lua_tl
    \tl_set_eq:cN { l__titrages_ #1 _pgf_tl } \l__titrages_charge_tl
    \tl_set:cx { l__titrages_ #1 _sigma_tl }
      {
        \l__titrages_sigma_tl
        + \fp_eval:n { \l__titrages_acide_fp * \l__titrages_lamA_fp
                       + \l__titrages_base_fp * \l__titrages_lamB_fp }
      }
    \bool_set_eq:cN { l__titrages_ #1 _sigma_bool } \l__titrages_sigma_bool
    \tl_set:cx { l__titrages_ #1 _acide_tl } { \fp_use:N \l__titrages_acide_fp }
    \tl_set:cx { l__titrages_ #1 _base_tl } { \fp_use:N \l__titrages_base_fp }
    \tl_set:cx { l__titrages_ #1 _lamA_tl } { \fp_use:N \l__titrages_lamA_fp }
    \tl_set:cx { l__titrages_ #1 _lamB_tl } { \fp_use:N \l__titrages_lamB_fp }
    \fp_set:cn { l__titrages_ #1 _b_fp } { \l__titrages_base_fp - \l__titrages_acide_fp }
  }
\tl_new:N \l__titrages_becher_lua_tl
\tl_new:N \l__titrages_burette_lua_tl
\tl_new:N \l__titrages_becher_pgf_tl
\tl_new:N \l__titrages_burette_pgf_tl
\tl_new:N \l__titrages_becher_sigma_tl
\tl_new:N \l__titrages_burette_sigma_tl
\bool_new:N \l__titrages_becher_sigma_bool
\bool_new:N \l__titrages_burette_sigma_bool
\tl_new:N \l__titrages_becher_acide_tl
\tl_new:N \l__titrages_becher_base_tl
\tl_new:N \l__titrages_burette_acide_tl
\tl_new:N \l__titrages_burette_base_tl
\tl_new:N \l__titrages_becher_lamA_tl
\tl_new:N \l__titrages_becher_lamB_tl
\tl_new:N \l__titrages_burette_lamA_tl
\tl_new:N \l__titrages_burette_lamB_tl
\fp_new:N \l__titrages_becher_b_fp
\fp_new:N \l__titrages_burette_b_fp

% --- clés : un titrage acido-basique ---------------------------------------------

\keys_define:nn { titrages / titrage }
  {
    volume     .code:n = { \fp_set:Nn \l__titrages_V_fp { #1 } } ,
