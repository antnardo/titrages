    volume~max .code:n = { \fp_set:Nn \l__titrages_Vmax_fp { #1 } } ,
    points     .code:n = { \int_set:Nn \l__titrages_points_int { #1 } } ,
    echelle    .code:n = { \fp_set:Nn \l__titrages_echelle_fp { #1 } } ,
