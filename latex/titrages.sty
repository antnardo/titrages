      { \str_set:Nx \l__titrages_unite_str { \l_keys_choice_tl } } ,
  }

\cs_new_protected:Npn \__titrages_initialiser:
  {
    \fp_set:Nn \l__titrages_V_fp { 10 }
    \fp_set:Nn \l__titrages_pKe_fp { 14 }
    \fp_zero:N \l__titrages_Vmax_fp
    \fp_set:Nn \l__titrages_echelle_fp { 1 }
    \int_set:Nn \l__titrages_points_int { 300 }
    \bool_set_true:N \l__titrages_dilution_bool
    \bool_set_false:N \l__titrages_corrigee_bool
    \str_set:Nn \l__titrages_abscisse_str { volume }
    \str_set:Nn \l__titrages_unite_str { S/m }
  }

\NewDocumentCommand \titragedefinir { m m }
  {
    \group_begin:
      \__titrages_initialiser:
      \__titrages_solution:nn { becher } { }
      \__titrages_solution:nn { burette } { }
      \keys_set:nn { titrages / titrage } { #2 }
      \str_if_eq:VnTF \g__titrages_moteur_str { lua }
        { \__titrages_definir_lua:n { #1 } }
        { \__titrages_definir_pgf:n { #1 } }
    \group_end:
  }

\cs_new_protected:Npn \__titrages_definir_lua:n #1
  {
    \lua_now:e
      {
        titrages.definir("\lua_escape:e { #1 }", {
          V0 = \fp_use:N \l__titrages_V_fp ,
          pKe = \fp_use:N \l__titrages_pKe_fp ,
          dilution = \bool_if:NTF \l__titrages_dilution_bool { true } { false } ,
          corrigee = \bool_if:NTF \l__titrages_corrigee_bool { true } { false } ,
          unite = "\l__titrages_unite_str" ,
          Vmax = \fp_use:N \l__titrages_Vmax_fp ,
          points = \int_use:N \l__titrages_points_int ,
          abscisse = "\l__titrages_abscisse_str" ,
          echelle = \fp_use:N \l__titrages_echelle_fp ,
          becher = { especes = { \l__titrages_becher_lua_tl } ,
                     acide = \l__titrages_becher_acide_tl ,
                     base = \l__titrages_becher_base_tl ,
                     lamA = \l__titrages_becher_lamA_tl ,
                     lamB = \l__titrages_becher_lamB_tl } ,
          burette = { especes = { \l__titrages_burette_lua_tl } ,
                      acide = \l__titrages_burette_acide_tl ,
                      base = \l__titrages_burette_base_tl ,
                      lamA = \l__titrages_burette_lamA_tl ,
                      lamB = \l__titrages_burette_lamB_tl } ,
        })
      }
  }

% Moteur pgf : on garde les expressions de V(x) et de sigma(x), x étant le pH.
\cs_new_protected:Npn \__titrages_definir_pgf:n #1
  {
    \str_if_eq:VnT \l__titrages_abscisse_str { n }
      { \msg_error:nn { titrages } { abscisse-pgf } }
    \tl_gclear_new:c { g__titrages_ #1 _type_tl }
    \tl_gset:cn { g__titrages_ #1 _type_tl } { ab }
    % V(x), brut, sans l'échelle
    \tl_gclear_new:c { g__titrages_ #1 _V_tl }
    \tl_gset:cx { g__titrages_ #1 _V_tl }
      {
        ( -( \fp_use:N \l__titrages_V_fp )
        * ( \l__titrages_becher_pgf_tl - ( \fp_use:N \l__titrages_becher_b_fp )
            + 10^( x - \fp_use:N \l__titrages_pKe_fp ) - 10^( 0 - x ) )
        / ( \l__titrages_burette_pgf_tl - ( \fp_use:N \l__titrages_burette_b_fp )
            \bool_if:NT \l__titrages_dilution_bool
              { + 10^( x - \fp_use:N \l__titrages_pKe_fp ) - 10^( 0 - x ) } ) )
      }
    \tl_gclear_new:c { g__titrages_ #1 _expr_tl }
    \tl_gset:cx { g__titrages_ #1 _expr_tl }
      { \tl_use:c { g__titrages_ #1 _V_tl } / ( \fp_use:N \l__titrages_echelle_fp ) }
    % sigma(x) = [V0 sigma_b + V sigma_bu] / (V0 + V) + lambda(H3O+) h + lambda(HO-) w
    \bool_if:nTF { \l__titrages_becher_sigma_bool && \l__titrages_burette_sigma_bool }
      {
        \tl_gclear_new:c { g__titrages_ #1 _sigma_tl }
        \tl_gset:cx { g__titrages_ #1 _sigma_tl }
          {
            \str_case_e:nn { \l__titrages_unite_str } { { S/m } { 1 } { mS/cm } { 10 } { mS/m } { 1000 } }
            * ( ( \fp_use:N \l__titrages_V_fp * ( \l__titrages_becher_sigma_tl )
                  + \tl_use:c { g__titrages_ #1 _V_tl } * ( \l__titrages_burette_sigma_tl ) )
                / ( \fp_use:N \l__titrages_V_fp + \tl_use:c { g__titrages_ #1 _V_tl } )
                + 34.98 * 10^( 0 - x ) + 19.86 * 10^( x - \fp_use:N \l__titrages_pKe_fp ) )
            \bool_if:NT \l__titrages_corrigee_bool
              {
                * ( \fp_use:N \l__titrages_V_fp + \tl_use:c { g__titrages_ #1 _V_tl } )
                / \fp_use:N \l__titrages_V_fp
              }
          }
        \__titrages_pgf_fonction:nv { __titrages_ #1 _sigma:n } { g__titrages_ #1 _sigma_tl }
      }
      {
        \cs_undefine:c { g__titrages_ #1 _sigma_tl }
        \cs_undefine:c { __titrages_ #1 _sigma:n }
      }
    \__titrages_domaine_pgf:n { #1 }
    % les mêmes expressions en fonctions l3fp de x, pour les nombres : R_b, R_bu, V
    \__titrages_pgf_fonction:nx { __titrages_ #1 _Rb:n }
      {
        \l__titrages_becher_pgf_tl - ( \fp_use:N \l__titrages_becher_b_fp )
        + 10^( x - \fp_use:N \l__titrages_pKe_fp ) - 10^( 0 - x )
      }
    \__titrages_pgf_fonction:nx { __titrages_ #1 _Rbu:n }
      {
        \l__titrages_burette_pgf_tl - ( \fp_use:N \l__titrages_burette_b_fp )
        \bool_if:NT \l__titrages_dilution_bool
          { + 10^( x - \fp_use:N \l__titrages_pKe_fp ) - 10^( 0 - x ) }
      }
    \__titrages_pgf_fonction:nv { __titrages_ #1 _V:n } { g__titrages_ #1 _V_tl }
    \tl_gclear_new:c { g__titrages_ #1 _xmin_tl }
    \tl_gset:cx { g__titrages_ #1 _xmin_tl } { -6 }
    \tl_gclear_new:c { g__titrages_ #1 _xmax_tl }
    \tl_gset:cx { g__titrages_ #1 _xmax_tl } { \fp_eval:n { \l__titrages_pKe_fp + 6 } }
  }

% Une expression en x, rangée en fonction l3fp d'un argument : \__titrages_<nom>_V:n {7}
% s'évalue dans \fp_eval:n, de façon développable. Le x devient le paramètre de la
% fonction : la liste, qui ne contient que des nombres et des opérateurs, est
% développée telle quelle dans la définition, où « #1 » est lu comme un paramètre.
\tl_new:N \l__titrages_fonction_tl
\cs_new_protected:Npn \__titrages_pgf_fonction:nn #1 #2
  {
    \tl_set:Nn \l__titrages_fonction_tl { #2 }
    \tl_replace_all:Nnn \l__titrages_fonction_tl { x } { ( ##1 ) }
    \cs_gset:cpx { #1 } ##1 { \l__titrages_fonction_tl }
  }
\cs_generate_variant:Nn \__titrages_pgf_fonction:nn { nv , nx }

\cs_new_protected:Npn \__titrages_domaine_pgf:n #1
  {
    \tl_gclear_new:c { g__titrages_ #1 _V0_tl }
    \tl_gset:cx { g__titrages_ #1 _V0_tl } { \fp_use:N \l__titrages_V_fp }
    \tl_gclear_new:c { g__titrages_ #1 _echelle_tl }
    \tl_gset:cx { g__titrages_ #1 _echelle_tl } { \fp_use:N \l__titrages_echelle_fp }
    \tl_gclear_new:c { g__titrages_ #1 _vmax_tl }
    \tl_gset:cx { g__titrages_ #1 _vmax_tl }
      {
        \fp_compare:nNnTF { \l__titrages_Vmax_fp } > { 0 }
          { \fp_eval:n { \l__titrages_Vmax_fp / \l__titrages_echelle_fp } }
          { \fp_eval:n { 2 * \l__titrages_V_fp / \l__titrages_echelle_fp } }
      }
    \tl_gclear_new:c { g__titrages_ #1 _points_tl }
    \tl_gset:cx { g__titrages_ #1 _points_tl } { \int_use:N \l__titrages_points_int }
  }

\cs_new_protected:Npn \__titrages_verifier_pgf:n #1
  { \tl_if_exist:cF { g__titrages_ #1 _expr_tl } { \msg_error:nnn { titrages } { inconnu } { #1 } } }

% --- clés : une espèce rédox --------------------------------------------------------
%
% forme = red (0, défaut), ox (la plus oxydée), ou un numéro de forme.

\keys_define:nn { titrages / redox / espece }
  {
    E0    .code:n = { \clist_set:Nx \l__titrages_E_clist { #1 } } ,
    n     .code:n = { \clist_set:Nx \l__titrages_n_clist { #1 } } ,
    H     .code:n = { \clist_set:Nx \l__titrages_H_clist { #1 } } ,
    stoechiometrie .code:n = { \clist_set:Nx \l__titrages_st_clist { #1 } } ,
    C     .code:n = { \fp_set:Nn \l__titrages_C_fp { #1 } } ,
    forme .code:n = { \tl_set:Nx \l__titrages_forme_tl { #1 } } ,
  }

% A_j = -sum_{i<=j} n_i E0_i, B_j = sum_{i<=j} H_i, c_j = sum_{i<=j} n_i ; les
% multiplicateurs 1/s, pH et (E + E_ref)/s ne sont connus qu'à la fin de la
% définition : on les écrit par des variables, développées à ce moment-là.
\cs_new_protected:Npn \__titrages_espece_redox:n #1
  {
    \clist_clear:N \l__titrages_E_clist
    \clist_clear:N \l__titrages_n_clist
    \clist_clear:N \l__titrages_H_clist
    \clist_set:Nn \l__titrages_st_clist { 1 , 1 }
    \fp_zero:N \l__titrages_C_fp
    \tl_set:Nn \l__titrages_forme_tl { red }
    \keys_set:nn { titrages / redox / espece } { #1 }
    \int_set:Nn \l__titrages_N_int { \clist_count:N \l__titrages_E_clist }
    \tl_put_right:Nx \l__titrages_lua_tl
      {
        { E0 = { \clist_map_function:NN \l__titrages_E_clist \__titrages_fp_virgule:n } ,
          n = { \l__titrages_n_clist } ,
          H = { \l__titrages_H_clist } ,
          st = { \l__titrages_st_clist } ,
          C = \fp_use:N \l__titrages_C_fp ,
          q = \str_case_e:nnF { \l__titrages_forme_tl }
                { { ox } { "ox" } { red } { "red" } } { \l__titrages_forme_tl } } ,
      }
    \str_if_eq:eeF { \clist_item:Nn \l__titrages_st_clist { 1 } \clist_item:Nn \l__titrages_st_clist { 2 } } { 11 }
      { \bool_set_false:N \l__titrages_monomere_bool }
    \bool_if:NT \l__titrages_monomere_bool
      {
        \seq_clear:N \l__titrages_A_seq
        \seq_clear:N \l__titrages_B_seq
        \seq_clear:N \l__titrages_c_seq
        \seq_put_right:Nn \l__titrages_A_seq { 0 }
        \seq_put_right:Nn \l__titrages_B_seq { 0 }
        \seq_put_right:Nn \l__titrages_c_seq { 0 }
        \fp_zero:N \l__titrages_s_fp  % A
        \fp_zero:N \l__titrages_t_fp  % c
        \int_zero:N \l__titrages_z_int % B
        \int_step_inline:nn { \l__titrages_N_int }
          {
            \fp_sub:Nn \l__titrages_s_fp
              { \__titrages_n:n { ##1 } * ( \clist_item:Nn \l__titrages_E_clist { ##1 } ) }
            \fp_add:Nn \l__titrages_t_fp { \__titrages_n:n { ##1 } }
            \int_add:Nn \l__titrages_z_int { \__titrages_H:n { ##1 } }
            \seq_put_right:Nx \l__titrages_A_seq { \fp_use:N \l__titrages_s_fp }
            \seq_put_right:Nx \l__titrages_B_seq { \int_use:N \l__titrages_z_int }
            \seq_put_right:Nx \l__titrages_c_seq { \fp_use:N \l__titrages_t_fp }
          }
        \__titrages_pgf_fractions:nnn
          { 1 / \l__titrages_nernst_tl } { \l__titrages_pH_tl } { ( x + \l__titrages_reference_tl ) / \l__titrages_nernst_tl }
        % électrons introduits par unité : c_q
        \int_set:Nn \l__titrages_q_int
          {
            \str_case_e:nnF { \l__titrages_forme_tl }
              { { ox } { \clist_count:N \l__titrages_E_clist } { red } { 0 } } { \l__titrages_forme_tl }
          }
        \tl_put_right:Nx \l__titrages_charge_tl
          {
            + ( \fp_use:N \l__titrages_C_fp ) * ( 0
              - \seq_item:Nn \l__titrages_c_seq { \l__titrages_q_int + 1 }
          }
        \int_step_inline:nn { \seq_count:N \l__titrages_x_seq }
          {
            \tl_put_right:Nx \l__titrages_charge_tl
              {
                + \seq_item:Nn \l__titrages_c_seq { ##1 }
                  * ( \seq_item:Nn \l__titrages_x_seq { ##1 } )
              }
          }
        \tl_put_right:Nn \l__titrages_charge_tl { ) }
      }
  }
\cs_new:Npn \__titrages_n:n #1
  { \int_compare:nNnTF { \clist_count:N \l__titrages_n_clist } < { #1 } { 1 } { \clist_item:Nn \l__titrages_n_clist { #1 } } }
\cs_new:Npn \__titrages_H:n #1
  { \int_compare:nNnTF { \clist_count:N \l__titrages_H_clist } < { #1 } { 0 } { \clist_item:Nn \l__titrages_H_clist { #1 } } }
\bool_new:N \l__titrages_monomere_bool
\tl_new:N \l__titrages_nernst_tl
\tl_new:N \l__titrages_pH_tl

\keys_define:nn { titrages / redox / solution }
  { espece .code:n = { \__titrages_espece_redox:n { #1 } } }

