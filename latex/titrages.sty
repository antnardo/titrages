% --- les nombres, sous le moteur pgf -------------------------------------------------
%
% Les expressions construites pour pgfplots, évaluées par l3fp (16 chiffres) : V(pH) et
% V(E) sont explicites ; pH(V), E(V) et σ(V) demandent une dichotomie sur
% V0 R_b(x) + V R_bu(x), croissant en x — 54 coupes sur [xmin, xmax], soit 2e-15 pour le
% pH. Tout est développable : \num{\titragepH{…}{…}} fonctionne aussi sous pgf. Les
% équivalences, les sauts et les tangentes demanderaient un troisième moteur : ils
% restent au moteur lua.

% #1 : une fonction de x (un argument), #2 : son argument
\cs_new:Npn \__titrages_pgf_residu:nnn #1 #2 #3
  {
    \tl_use:c { g__titrages_ #1 _V0_tl } * ( \use:c { __titrages_ #1 _Rb:n } { #3 } )
    + ( #2 ) * ( \use:c { __titrages_ #1 _Rbu:n } { #3 } )
  }
% La racine d'une fonction croissante #1 (tokens attendant un argument) sur [#2, #3].
\cs_new:Npn \__titrages_pgf_racine:nnn #1 #2 #3
  { \__titrages_pgf_racine_aux:nnnn { #1 } { 54 } { #2 } { #3 } }
\cs_new:Npn \__titrages_pgf_racine_aux:nnnn #1 #2 #3 #4
  {
    \int_compare:nNnTF { #2 } = { 0 }
      { \fp_eval:n { ( #3 + #4 ) / 2 } }
      {
        \exp_args:Nf \__titrages_pgf_racine_milieu:nnnnn { \fp_eval:n { ( #3 + #4 ) / 2 } }
          { #1 } { #2 } { #3 } { #4 }
      }
  }
\cs_new:Npn \__titrages_pgf_racine_milieu:nnnnn #1 #2 #3 #4 #5
  {
    \fp_compare:nNnTF { #2 { #1 } } > { 0 }
      { \exp_args:Nnf \__titrages_pgf_racine_aux:nnnn { #2 } { \int_eval:n { #3 - 1 } } { #4 } { #1 } }
      { \exp_args:Nnf \__titrages_pgf_racine_aux:nnnn { #2 } { \int_eval:n { #3 - 1 } } { #1 } { #5 } }
  }
% L'arrondi des nombres ; nan pour un volume négatif ou infini, comme le moteur lua.
\cs_new:Npn \__titrages_pgf_arrondi:n #1
  { \fp_eval:n { round( #1 , \g__titrages_chiffres_int ) } }
\cs_new:Npn \__titrages_pgf_volume_arrondi:n #1
  {
    \fp_compare:nNnTF { #1 } < { 0 }
      { nan }
      { \fp_compare:nNnTF { #1 } > { 1e300 } { nan } { \__titrages_pgf_arrondi:n { #1 } } }
  }
% Les vérifications, développables : le titrage existe, et il est du bon type.
\cs_new:Npn \__titrages_pgf_existe:nn #1 #2
  {
    \cs_if_exist:cTF { __titrages_ #1 _V:n } { #2 }
      { \msg_expandable_error:nnn { titrages } { inconnu } { #1 } }
  }
\cs_new:Npn \__titrages_pgf_type:nnnn #1 #2 #3 #4
  {
    \str_if_eq:eeTF { \tl_use:c { g__titrages_ #1 _type_tl } } { #2 } { #4 }
      { \msg_expandable_error:nnnn { titrages } { lecture } { #1 } { #3 } }
  }
\cs_new:Npn \__titrages_pgf_nombre_volume:nn #1 #2
  {
    \__titrages_pgf_existe:nn { #1 }
      {
        \__titrages_pgf_volume_arrondi:n
          { \use:c { __titrages_ #1 _V:n } { \fp_eval:n { #2 } } / \tl_use:c { g__titrages_ #1 _echelle_tl } }
      }
  }
% #1 nom, #2 volume versé (unité de l'abscisse), #3 type attendu, #4 nom de l'autre commande
\cs_new:Npn \__titrages_pgf_nombre_racine:nnnn #1 #2 #3 #4
  {
    \__titrages_pgf_existe:nn { #1 }
      {
        \__titrages_pgf_type:nnnn { #1 } { #3 } { #4 }
          {
            \__titrages_pgf_arrondi:n
              {
                \__titrages_pgf_racine:nnn
                  { \__titrages_pgf_residu:nnn { #1 } { \fp_eval:n { ( #2 ) * \tl_use:c { g__titrages_ #1 _echelle_tl } } } }
                  { \tl_use:c { g__titrages_ #1 _xmin_tl } } { \tl_use:c { g__titrages_ #1 _xmax_tl } }
              }
          }
      }
  }
\cs_new:Npn \__titrages_pgf_nombre_conductivite:nn #1 #2
  {
    \__titrages_pgf_existe:nn { #1 }
      {
        \__titrages_pgf_type:nnnn { #1 } { ab } { \titrageE }
          {
            \cs_if_exist:cTF { __titrages_ #1 _sigma:n }
              {
                \__titrages_pgf_arrondi:n
                  {
                    \exp_args:Nf \use:c { __titrages_ #1 _sigma:n }
                      {
                        \__titrages_pgf_racine:nnn
                          { \__titrages_pgf_residu:nnn { #1 } { \fp_eval:n { ( #2 ) * \tl_use:c { g__titrages_ #1 _echelle_tl } } } }
                          { \tl_use:c { g__titrages_ #1 _xmin_tl } } { \tl_use:c { g__titrages_ #1 _xmax_tl } }
                      }
                  }
              }
              { \msg_expandable_error:nnn { titrages } { sigma-pgf } { #1 } }
          }
      }
  }

\str_if_eq:VnF \g__titrages_moteur_str { lua }
  {
    \RenewExpandableDocumentCommand \titragevolume { m m }
      { \__titrages_pgf_nombre_volume:nn { #1 } { #2 } }
    \RenewExpandableDocumentCommand \titragepH { m m }
      { \__titrages_pgf_nombre_racine:nnnn { #1 } { #2 } { ab } { \titrageE } }
    \RenewExpandableDocumentCommand \titragepHinitial { m }
      { \__titrages_pgf_nombre_racine:nnnn { #1 } { 0 } { ab } { \titrageE } }
    \RenewExpandableDocumentCommand \titrageE { m m }
      { \__titrages_pgf_nombre_racine:nnnn { #1 } { #2 } { redox } { \titragepH } }
    \RenewExpandableDocumentCommand \titrageconductivite { m m }
      { \__titrages_pgf_nombre_conductivite:nn { #1 } { #2 } }
    % Ceux-là demandent le moteur lua : on le dit, au lieu d'une erreur obscure.
    \RenewDocumentCommand \titrageequivalence { m m }
      { \msg_error:nnn { titrages } { lua-seulement } { \titrageequivalence } }
    \clist_map_inline:nn { \titragesaut , \titragetangentes }
      { \RenewDocumentCommand #1 { O{} m m } { \msg_error:nnn { titrages } { lua-seulement } { #1 } } }
  }

