% titrages.sty — courbes de titrage sans approximation, dans pgfplots :
% pH-métrie, conductimétrie, potentiométrie.
%
% Copyright (c) 2026 antnardo — licence MIT (voir LICENSE).
%
% Deux moteurs derrière une seule interface :
%   - lua (défaut sous LuaLaTeX) : titrages.lua calcule en double précision, résout
%     le pH ou le potentiel à volume donné, repère les sauts, construit la méthode des
%     tangentes, traite les couples rédox dimériques (I2/I-, Cr2O7^2-/Cr3+) ;
%   - pgf (défaut ailleurs) : les courbes sont des courbes paramétrées par le pH (ou
%     le potentiel), V = V(pH), l'expression étant construite ici et confiée à
%     pgfplots. Courbes pH, σ et E (couples monomères) et fractions. La même
%     expression, évaluée par l3fp (16 chiffres), donne aussi les nombres qui ne
%     demandent qu'une évaluation ou une dichotomie : V(pH), pH(V), σ(V), E(V) ;
%     ni équivalences, ni sauts, ni tangentes, qui demanderaient un troisième
%     moteur complet.
%
% Le principe est celui du paquet Python titrages : à pH (ou potentiel) imposé tout
% est explicite, et V = -V0 R_becher / R_burette, R étant le résidu de
% l'électroneutralité (ou du bilan d'électrons) de chaque solution.

\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{titrages}{2026-10-11}{0.1.2}{Courbes de titrage sans approximation}

\RequirePackage{pgfplots}

% --- options du paquet --------------------------------------------------------

\str_new:N \g__titrages_moteur_str
\sys_if_engine_luatex:TF
  { \str_gset:Nn \g__titrages_moteur_str { lua } }
  { \str_gset:Nn \g__titrages_moteur_str { pgf } }

\keys_define:nn { titrages / paquet }
  {
    moteur .choices:nn = { lua , pgf }
      { \str_gset:Nx \g__titrages_moteur_str { \l_keys_choice_tl } } ,
  }
\ProcessKeyOptions [ titrages / paquet ]

\str_if_eq:VnT \g__titrages_moteur_str { lua }
  {
    \sys_if_engine_luatex:F
      {
        \msg_new:nnn { titrages } { lua-sans-luatex }
          { Le~moteur~lua~demande~LuaLaTeX~;~moteur~pgf~retenu. }
        \msg_warning:nn { titrages } { lua-sans-luatex }
        \str_gset:Nn \g__titrages_moteur_str { pgf }
      }
  }

