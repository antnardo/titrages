      {
        \__titrages_verifier_pgf:n { #2 }
        \str_if_eq:eeT { \tl_use:c { g__titrages_ #2 _type_tl } } { redox }
          { \msg_error:nnn { titrages } { pas-redox } { #2 } }
        \tl_if_exist:cF { g__titrages_ #2 _sigma_tl }
          { \msg_error:nnn { titrages } { sigma-pgf } { #2 } }
        \__titrages_addplot_param:nvvveev { #1 }
          { g__titrages_ #2 _expr_tl } { g__titrages_ #2 _vmax_tl } { g__titrages_ #2 _points_tl }
          { \fp_use:N \g__titrages_pHmin_fp } { \fp_use:N \g__titrages_pHmax_fp }
          { g__titrages_ #2 _sigma_tl }
      }
  }

