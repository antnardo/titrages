% La référence, en V/ENH : un nom connu, ou un nombre.
\cs_new:Npn \__titrages_reference:n #1
  { \str_case:nnF { #1 } { { ENH } { 0 } { ECS } { 0.244 } { Ag/AgCl } { 0.197 } } { \fp_eval:n { #1 } } }

\NewDocumentCommand \titrageredoxdefinir { m m }
  {
    \group_begin:
      \__titrages_initialiser:
      \fp_zero:N \l__titrages_pH_fp
      \fp_set:Nn \l__titrages_nernst_fp { 0.05916 }
      \bool_set_true:N \l__titrages_monomere_bool
      % les multiplicateurs restent symboliques jusqu'à la fin
      \tl_set:Nn \l__titrages_nernst_tl { \l__titrages_nernst_val_tl }
      \tl_set:Nn \l__titrages_pH_tl { \l__titrages_pH_val_tl }
      \tl_set:Nn \l__titrages_reference_tl { \l__titrages_ref_val_tl }
      \__titrages_solution_redox:nn { becher } { }
      \__titrages_solution_redox:nn { burette } { }
      \tl_set:Nn \l__titrages_ref_nom_tl { ENH }
      \keys_set:nn { titrages / redox / titrage } { #2 }
      \str_if_eq:VnTF \g__titrages_moteur_str { lua }
        { \__titrages_definir_redox_lua:n { #1 } }
        { \__titrages_definir_redox_pgf:n { #1 } }
    \group_end:
  }
\tl_new:N \l__titrages_ref_nom_tl
\tl_new:N \l__titrages_nernst_val_tl
\tl_new:N \l__titrages_pH_val_tl
\tl_new:N \l__titrages_ref_val_tl

% La clé reference écrase la variable symbolique : on la relit.
\keys_define:nn { titrages / redox / titrage }
  { reference .code:n = { \tl_set:Nn \l__titrages_ref_nom_tl { #1 } } }

\cs_new_protected:Npn \__titrages_definir_redox_lua:n #1
  {
    \lua_now:e
      {
        titrages.definir_redox("\lua_escape:e { #1 }", {
          V0 = \fp_use:N \l__titrages_V_fp ,
          pH = \fp_use:N \l__titrages_pH_fp ,
          pente = \fp_use:N \l__titrages_nernst_fp ,
          reference = \__titrages_reference:V \l__titrages_ref_nom_tl ,
          Vmax = \fp_use:N \l__titrages_Vmax_fp ,
          points = \int_use:N \l__titrages_points_int ,
          abscisse = "\l__titrages_abscisse_str" ,
          echelle = \fp_use:N \l__titrages_echelle_fp ,
          becher = { especes = { \l__titrages_becher_lua_tl } } ,
          burette = { especes = { \l__titrages_burette_lua_tl } } ,
        })
      }
  }
\cs_generate_variant:Nn \__titrages_reference:n { V }

\cs_new_protected:Npn \__titrages_definir_redox_pgf:n #1
  {
    \bool_if:NF \l__titrages_monomere_bool
      { \msg_error:nnn { titrages } { dimere-pgf } { 1,2 } }
    \str_if_eq:VnT \l__titrages_abscisse_str { n }
      { \msg_error:nn { titrages } { abscisse-pgf } }
    \tl_set:Nx \l__titrages_nernst_val_tl { \fp_use:N \l__titrages_nernst_fp }
    \tl_set:Nx \l__titrages_pH_val_tl { \fp_use:N \l__titrages_pH_fp }
    \tl_set:Nx \l__titrages_ref_val_tl { \__titrages_reference:V \l__titrages_ref_nom_tl }
    \tl_gclear_new:c { g__titrages_ #1 _type_tl }
    \tl_gset:cn { g__titrages_ #1 _type_tl } { redox }
    \tl_gclear_new:c { g__titrages_ #1 _V_tl }
    \tl_gset:cx { g__titrages_ #1 _V_tl }
      { -( \fp_use:N \l__titrages_V_fp ) * ( \l__titrages_becher_pgf_tl ) / ( \l__titrages_burette_pgf_tl ) }
    \tl_gclear_new:c { g__titrages_ #1 _expr_tl }
    \tl_gset:cx { g__titrages_ #1 _expr_tl }
      { \tl_use:c { g__titrages_ #1 _V_tl } / ( \fp_use:N \l__titrages_echelle_fp ) }
    \__titrages_domaine_pgf:n { #1 }
    \__titrages_pgf_fonction:nx { __titrages_ #1 _Rb:n } { \l__titrages_becher_pgf_tl }
    \__titrages_pgf_fonction:nx { __titrages_ #1 _Rbu:n } { \l__titrages_burette_pgf_tl }
    \__titrages_pgf_fonction:nv { __titrages_ #1 _V:n } { g__titrages_ #1 _V_tl }
    % la dichotomie en E mesuré : [-3, 4] V/ENH, moins la référence
    \tl_gclear_new:c { g__titrages_ #1 _xmin_tl }
    \tl_gset:cx { g__titrages_ #1 _xmin_tl } { \fp_eval:n { -3 - \l__titrages_ref_val_tl } }
    \tl_gclear_new:c { g__titrages_ #1 _xmax_tl }
    \tl_gset:cx { g__titrages_ #1 _xmax_tl } { \fp_eval:n { 4 - \l__titrages_ref_val_tl } }
    \cs_undefine:c { __titrages_ #1 _sigma:n }
  }

